<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package (T409). build\build-msix.cmd fills {VERSION} from <Version> in
  ClaudeTray.csproj, so the version still lives in one place; the Store requires the fourth part to be 0.

  Identity is the Partner Center reservation (account Alegauss, Store ID 9P27BHWNT56D). The Store signs
  the package, so Publisher must match the reservation exactly or the upload is refused.

  Two extensions are why this file exists rather than a plain installer:
  - the execution alias puts ClaudeTray.exe on PATH, which is what PackageIdentity.Alias names and what
    the status-line command runs: the package's own folder under WindowsApps cannot be launched from
    outside it;
  - the startup task replaces the HKCU Run entry, which a package writes into its private hive where
    Explorer never looks. Enabled by default, as the installer's choice was, and the user turns it off
    in Settings > Apps > Startup, which is where the app's own Settings page sends them.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop rescap">

  <Identity Name="Alegauss.ClaudeCodeTray"
            Publisher="CN=1ADDE401-7D09-4729-8E49-C28AEEA80170"
            Version="{VERSION}"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Claude Code Tray</DisplayName>
    <PublisherDisplayName>Alegauss</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="pt-br" />
    <Resource Language="pt-pt" />
    <Resource Language="fr-fr" />
    <Resource Language="es-es" />
  </Resources>

  <Applications>
    <Application Id="ClaudeTray" Executable="ClaudeTray.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Claude Code Tray"
        Description="Unofficial Windows tray app for your Claude Code limit."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="ClaudeTray.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask TaskId="ClaudeTray" Enabled="true" DisplayName="Claude Code Tray" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
