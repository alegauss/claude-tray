<!-- One of the three destinations of MainWindow, not a window of its own: the shell owns the title
     bar, the size and the theme, and this is only what sits under its nav strip. -->
<UserControl x:Class="ClaudeTray.StatisticsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeTray"
        x:ClassModifier="internal"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <UserControl.Resources>
        <!-- A mini stat inside a pane: big value over a small caption. -->
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="StatCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- The "i" that opens the method popup: a 20px round glyph button, quiet until pointed at and
             filled while its popup is open, so the toggle state is visible without a second control. -->
        <Style x:Key="InfoDot" TargetType="ToggleButton">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Dot" CornerRadius="10" Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== One conversation, as a row (T328). Project, clock, duration, turns, tokens â€” and,
             since T334, the opening prompt under the project. That last one is Â§I.1's single amended
             exception and the only thing here a person wrote; it is truncated by the index before it
             is stored, so this template is a display and not a second place the cap is decided. -->
        <!-- One line of the call tree under a conversation (T329). Own beside subtree, so a
             coordinator that was cheap under a fleet that was not reads as exactly that. -->
        <DataTemplate x:Key="TaskLineTemplate">
            <Grid Margin="{Binding Indent}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="188" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="84" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,3,10,3">
                    <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Prompt}" Visibility="{Binding PromptVisibility}"
                               FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Effort}" Visibility="{Binding EffortVisibility}"
                           FontSize="11" VerticalAlignment="Top" Margin="0,4,10,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding Calls}" FontSize="12" VerticalAlignment="Top"
                           Margin="0,3,12,0" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <StackPanel Grid.Column="3" Margin="0,3,0,0" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Own}" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding Tree}" FontSize="11" HorizontalAlignment="Right"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SessionRowTemplate">
          <StackPanel>
            <Border Padding="8,7" CornerRadius="5" Background="Transparent" ToolTip="{Binding Tip}"
                    Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="124" />
                    </Grid.ColumnDefinitions>
                    <!-- Project over prompt, in that order and in that weight: which repo a prompt
                         was typed in is half of recognising it, so the identifier leads and the
                         person's own words sit under it, dimmer and on one trimmed line. The numeric
                         columns are top-aligned against that first line rather than centred on a
                         two-line cell, so the eye still reads straight across a row. -->
                    <!-- A Grid and not a horizontal StackPanel, which is the whole of T338: a
                         horizontal StackPanel measures its children at *infinite* width, so every
                         TextTrimming below reported that nothing was too wide, and the Grid column
                         clipped the text mid-word instead. A `*` column measures at the width it
                         actually has, so the ellipsis lands where the text ends. A fixed Width or
                         MaxWidth would be the same bug at every other window size. -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- The disclosure glyph is the affordance: a row that opens into a call
                             tree and looks exactly like one that does not is a feature only its
                             author finds (T329). -->
                        <TextBlock Grid.Column="0" Text="{Binding Chevron}" FontFamily="Segoe MDL2 Assets"
                                   FontSize="9" Margin="0,4,8,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Project}" FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Title}" Visibility="{Binding TitleVisibility}"
                                       FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Prompt}" Visibility="{Binding PromptVisibility}"
                                       FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <!-- Effort under the identity rather than in a column of its own: a mix
                                 is two or three words wide, and the columns beside it are numbers
                                 that have to stay aligned to be comparable (T331). -->
                            <TextBlock Text="{Binding Effort}" Visibility="{Binding EffortVisibility}"
                                       FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="13" VerticalAlignment="Top"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="13" VerticalAlignment="Top"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="{Binding Turns}" FontSize="13" VerticalAlignment="Top"
                               HorizontalAlignment="Right" Margin="0,0,12,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="{Binding Tokens}" FontSize="13" VerticalAlignment="Top"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <!-- The list-price equivalent, dimmer than the token count beside it (T346): tokens
                         are what the app counted and this is arithmetic over them at a published rate,
                         so it reads as the explanation and not as the measurement. Never the word
                         "cost" — the column heading carries "at list prices" and the method note behind
                         the footer's ⓘ carries the rest. Blank where nothing could be priced. -->
                    <TextBlock Grid.Column="5" Text="{Binding Money}" FontSize="13" VerticalAlignment="Top"
                               HorizontalAlignment="Stretch" TextAlignment="Right"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding MoneyTip}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Detail}" Visibility="{Binding DetailVisibility}"
                          ItemTemplate="{StaticResource TaskLineTemplate}"
                          Margin="8,0,0,8" />
          </StackPanel>
        </DataTemplate>

        <!-- A column header that sorts. Looks like a label and behaves like a button, because it is
             one: a heading that reorders the list on click and gives no affordance is a feature only
             its author finds. -->
        <Style x:Key="SortHeader" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   Foreground="{TemplateBinding Foreground}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Colored verdict pill; background + text are set in code from the pace verdict. -->
        <Style x:Key="VerdictChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ===== Segmented control: the two windows as pill segments instead of faint underline tabs.
             The selected segment fills with the system accent; the whole thing sits in a rounded track. -->
        <Style x:Key="SegItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Seg" CornerRadius="7" Margin="2" Padding="22,8"
                                Background="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Seg" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <!-- Theme's on-accent text brush: adapts to a light *or* dark accent so
                                     the label always contrasts, instead of a fixed white that vanishes
                                     on a light accent color. -->
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegControl" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" HorizontalAlignment="Left" CornerRadius="9" Padding="2"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <!-- The name is not decoration: TabControl finds its content host by
                                 GetTemplateChild("PART_SelectedContentHost"), and TabItem's automation
                                 peer asks for it to attach the selected tab's children. Without it the
                                 whole pane â€” every number, chart legend and projection sentence â€” is
                                 absent from the UI Automation tree, so a screen reader reads three tab
                                 headers over an empty body and no check can read the window either
                                 (found by writing one, T165). -->
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><!-- header -->
            <RowDefinition Height="*" />   <!-- panes -->
            <RowDefinition Height="Auto" /><!-- footer -->
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <StackPanel Grid.Row="0" Margin="32,26,32,0">
            <TextBlock Text="{local:Loc stats.header}"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Margin="0,3,0,0" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{local:Loc stats.subtitle}" />

            <!-- Profile picker (T128) â€” only when this machine has more than one Claude Code profile.
                 Everything below is recomputed from the chosen profile's own stores and transcripts. -->
            <Border x:Name="ProfileCard" Visibility="Collapsed" Margin="0,14,0,0"
                    CornerRadius="8" Padding="14,10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProfileLabel" Grid.Column="0" Text="{local:Loc stats.profile}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{local:Loc stats.profileHint}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="12,0,12,0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <!-- LabeledBy, not a second copy of the string (T175): the picker's label is the
                         TextBlock beside it, which the automation tree cannot associate on its own, so
                         without this the control that decides what the whole report is about announces
                         itself as "combo box" and nothing else. -->
                    <ComboBox Grid.Column="2" x:Name="StatsProfileCombo" MinWidth="180"
                              VerticalAlignment="Center"
                              AutomationProperties.LabeledBy="{Binding ElementName=ProfileLabel}" />
                </Grid>
            </Border>

            <!-- Shown only during an API outage: the reason, over charts drawn from the last known
                 local data. Kept collapsed otherwise. -->
            <Border x:Name="ErrorBanner" Visibility="Collapsed" Margin="0,12,0,0"
                    CornerRadius="8" Padding="12,9" Background="#332B1416" BorderThickness="1"
                    BorderBrush="#66E33B30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               VerticalAlignment="Top" Margin="0,1,10,0" Foreground="#E86A5E" />
                    <TextBlock Grid.Column="1" x:Name="ErrorBannerText" TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- ===== Panes (one tab per rate-limit window, so each fits without scrolling) ===== -->
        <Grid Grid.Row="1" Margin="30,16,30,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="StatsStatusText" Grid.RowSpan="2"
                       Margin="4,24,4,0" FontSize="14" TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TabControl x:Name="PanesBody" Grid.Row="0" Visibility="Collapsed"
                        Style="{StaticResource SegControl}" ItemContainerStyle="{StaticResource SegItem}">
                <!-- ============ SESSION (5h) ============ -->
                <TabItem Header="{local:Loc stats.tab.session}">
                    <!-- Scrolls only when it has to: the panes are sized to fit, but a long projection
                         sentence in a wordier language (or a short screen) used to be clipped outright
                         with no way to read it. Auto keeps the scrollbar invisible in the normal case. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,20,14,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="{local:Loc stats.session.hint}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Border Grid.Column="1" x:Name="ChipS" Style="{StaticResource VerdictChip}">
                                <TextBlock x:Name="ChipTextS" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="UsedS" Style="{StaticResource StatValue}" />
                                <TextBlock x:Name="UsedCaptionS" Text="{local:Loc stats.stat.used}" Style="{StaticResource StatCaption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="IdealS" Style="{StaticResource StatValue}" />
                                <TextBlock Text="{local:Loc stats.stat.ideal}" Style="{StaticResource StatCaption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="ResetS" Style="{StaticResource StatValue}" />
                                <TextBlock Text="{local:Loc stats.stat.reset}" Style="{StaticResource StatCaption}" />
                            </StackPanel>
                        </Grid>

                        <Canvas x:Name="ChartS" Height="188" Margin="0,20,0,0"
                                ClipToBounds="True" SizeChanged="Chart_SizeChanged" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock x:Name="LegendActualS" Text="{local:Loc stats.legend.actual}" Margin="6,0,16,0" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Rectangle Width="16" Height="2" VerticalAlignment="Center" Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{local:Loc stats.legend.evenPace}" Margin="6,0,16,0" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Rectangle Width="16" Height="2" VerticalAlignment="Center" Fill="#E0A030" />
                            <TextBlock Text="{local:Loc stats.legend.projection}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <!-- The two clay entries this tab was missing entirely (T308). DrawChart is one
                                 method over both canvases and the overage header bit is a fact about the
                                 account rather than about a five-hour stretch, so a session past the
                                 included quota gets the band, and the second axis when a figure rules one â€”
                                 beside a legend that named three lines. Same strings and same predicates as
                                 the weekly pair, because it is the same news about a shorter window. -->
                            <StackPanel x:Name="LegendExtraS" Orientation="Horizontal" Margin="16,0,0,0" Visibility="Collapsed">
                                <Rectangle Width="16" Height="2" VerticalAlignment="Center" Fill="{x:Static local:Brand.ClayBrush}" />
                                <!-- Text set per mode (T318): this axis does not flip with the left one, so
                                     in remaining mode it has to say it is still counting what was spent. -->
                                <TextBlock x:Name="LegendExtraTextS" Text="{local:Loc stats.legend.extra}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <!-- Both halves declared and each shown only when its shape was drawn (T311); the
                                 tooltip is set per render for the same reason. On this tab that resolves to
                                 band-only, because nothing sets Session.Ghost â€” decided by the same reader as
                                 the weekly entry rather than hardcoded here, so a session that ever grows a
                                 ghost gets a right legend instead of a quietly wrong one. -->
                            <StackPanel x:Name="LegendOverS" Orientation="Horizontal" Margin="16,0,0,0" Visibility="Collapsed">
                                <Grid Width="16" Height="10" VerticalAlignment="Center">
                                    <Rectangle x:Name="OverSwatchBandS" RadiusX="2" RadiusY="2" Fill="{x:Static local:Brand.ClayBandBrush}" />
                                    <!-- No VerticalAlignment here: which edge the ceiling is on flips with
                                         the used/remaining axis, so it is set per render from the same fact
                                         the mark's own offset comes from (T316). -->
                                    <Rectangle x:Name="OverSwatchCeilingS" Width="10" Height="3" HorizontalAlignment="Left"
                                               Fill="{x:Static local:Brand.ClayBrush}" Opacity="0.8" />
                                </Grid>
                                <TextBlock Text="{local:Loc stats.legend.overQuota}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Throughput. Two numbers on two clocks: this window's average (still by
                             construction â€” it divides by the whole elapsed window) and, under it, one
                             line of the live rate. The strip itself lives on the Throughput tab (T111):
                             it is "now", identical on both pace tabs, so it was the same picture twice.
                             The number stays here, because the pace report is where you'd miss it. -->
                        <TextBlock x:Name="TpsHeadS" Margin="0,18,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel x:Name="TpsLegendS" Orientation="Horizontal" Margin="0,8,0,0" />
                        <TextBlock x:Name="LiveHeadS" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock x:Name="ProjectionS" Margin="0,16,0,0" TextWrapping="Wrap" LineHeight="20"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ WEEK (7d) ============ -->
                <TabItem Header="{local:Loc stats.tab.week}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,20,14,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="{local:Loc stats.week.hint}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Border Grid.Column="1" x:Name="ChipW" Style="{StaticResource VerdictChip}">
                                <TextBlock x:Name="ChipTextW" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="UsedW" Style="{StaticResource StatValue}" />
                                <TextBlock x:Name="UsedCaptionW" Text="{local:Loc stats.stat.used}" Style="{StaticResource StatCaption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="IdealW" Style="{StaticResource StatValue}" />
                                <TextBlock Text="{local:Loc stats.stat.ideal}" Style="{StaticResource StatCaption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="ResetW" Style="{StaticResource StatValue}" />
                                <TextBlock Text="{local:Loc stats.stat.reset}" Style="{StaticResource StatCaption}" />
                            </StackPanel>
                        </Grid>

                        <Canvas x:Name="ChartW" Height="188" Margin="0,20,0,0"
                                ClipToBounds="True" SizeChanged="Chart_SizeChanged" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock x:Name="LegendActualW" Text="{local:Loc stats.legend.actual}" Margin="6,0,16,0" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Rectangle Width="16" Height="2" VerticalAlignment="Center" Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{local:Loc stats.legend.evenPace}" Margin="6,0,16,0" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Rectangle Width="16" Height="2" VerticalAlignment="Center" Fill="#E0A030" />
                            <TextBlock Text="{local:Loc stats.legend.projection}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <!-- Shown only when the projection follows the activity shape and there are
                                 usually-idle stretches ahead to band (see Render). -->
                            <StackPanel x:Name="LegendIdleW" Orientation="Horizontal" Margin="16,0,0,0" Visibility="Collapsed">
                                <Rectangle Width="16" Height="10" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Fill="#3DE0A030" />
                                <TextBlock Text="{local:Loc stats.legend.usualIdle}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <!-- Shown only when this window carries an overage series (T183). Named as
                                 having its own scale right here in the legend, because it is the one line
                                 on this chart that is NOT read against the percentage axis. -->
                            <StackPanel x:Name="LegendExtraW" Orientation="Horizontal" Margin="16,0,0,0" Visibility="Collapsed">
                                <Rectangle Width="16" Height="2" VerticalAlignment="Center" Fill="{x:Static local:Brand.ClayBrush}" />
                                <!-- Text set per mode â€” see the 5h twin (T318). -->
                                <TextBlock x:Name="LegendExtraTextW" Text="{local:Loc stats.legend.extra}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <!-- The two clay marks, named once (T300): this week's shaded stretch (T275) and
                                 last week's mark at the ceiling (T295) are one fact about two different
                                 weeks, so they get one entry and the week is left to the hover â€” which the
                                 tooltip is what makes findable at all. Shown when *either* is on the chart,
                                 because most weeks carry only one: an entry for a mark nobody drew is the
                                 same defect one step on.
                                 Which is why the swatch's two halves are shown per render and the tooltip is
                                 set with them (T311) â€” describing both shapes on a chart carrying one was
                                 that defect, inside the entry. The band is brightened the way the idle one
                                 is, because 0.14 over 10px is nothing to look at, and the ceiling bar is
                                 short and thick like the chart's, which also keeps it apart from the
                                 full-width 2px line of the extra-usage entry beside it. -->
                            <StackPanel x:Name="LegendOverW" Orientation="Horizontal" Margin="16,0,0,0" Visibility="Collapsed">
                                <Grid Width="16" Height="10" VerticalAlignment="Center">
                                    <Rectangle x:Name="OverSwatchBandW" RadiusX="2" RadiusY="2" Fill="{x:Static local:Brand.ClayBandBrush}" />
                                    <!-- Alignment set per render, with the mark's offset â€” see the 5h twin. -->
                                    <Rectangle x:Name="OverSwatchCeilingW" Width="10" Height="3" HorizontalAlignment="Left"
                                               Fill="{x:Static local:Brand.ClayBrush}" Opacity="0.8" />
                                </Grid>
                                <TextBlock Text="{local:Loc stats.legend.overQuota}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <!-- Shown only when enough of last week was recorded to draw its ghost. -->
                            <StackPanel x:Name="LegendGhostW" Orientation="Horizontal" Margin="16,0,0,0" Visibility="Collapsed">
                                <Rectangle Width="16" Height="2" VerticalAlignment="Center" Opacity="0.32"
                                           Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="{local:Loc stats.legend.lastWeek}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Same pair as the 5h tab: this window's average, then the one-line live rate.
                             The average is window-scoped (a week's denominator, so it barely moves);
                             the strip it used to sit above is on the Throughput tab. -->
                        <TextBlock x:Name="TpsHeadW" Margin="0,18,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel x:Name="TpsLegendW" Orientation="Horizontal" Margin="0,8,0,0" />
                        <TextBlock x:Name="LiveHeadW" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock x:Name="ProjectionW" Margin="0,16,0,0" TextWrapping="Wrap" LineHeight="20"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ THROUGHPUT (now) ============
                     The live strip's own tab (T111). It was duplicated under both charts because it is
                     the one thing here that is *not* window-scoped â€” and squeezed into 56px, where a
                     minute of ordinary work sits on the 1px floor next to a single large cache write.
                     Given a tab it gets the height that makes a rate legible, and the two window
                     averages come along for comparison: same tokens, slower clock. -->
                <TabItem Header="{local:Loc stats.tab.throughput}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- Bottom margin, not padding-by-accident: the pane clips, and a line cut in half
                         at the viewport edge reads as a bug even when the content does scroll. -->
                    <StackPanel Margin="4,18,14,16">
                        <TextBlock Text="{local:Loc stats.throughput.hint}" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock x:Name="LiveHeadT" Margin="0,16,0,0" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <!-- Two charts of the same rate, one per decomposition, both always on screen
                             (T116). The old single chart switched from per-type to per-project the
                             moment a second repo started generating â€” the colours changed meaning
                             under the reader, which is the one thing a live chart must never do. -->
                        <TextBlock Text="{local:Loc stats.throughput.byProject}" Margin="0,16,0,0"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <!-- A spike here has a name, and this is the direction of that join with data behind it: the
                             strip is five minutes and the list is seven days, so a task cannot light this
                             chart, but this chart can name the running task (T337). -->
                        <Border x:Name="ChartProjects" Cursor="Hand"
                                MouseLeftButtonUp="LiveChart_Clicked"
                                ToolTip="{local:Loc stats.live.clickTip}"
                                Height="178" Margin="0,6,0,0" CornerRadius="6" ClipToBounds="True"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <!-- The time axis, stated rather than implied: oldest second at the left, the
                             one still filling at the right. -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{local:Loc stats.live.axisAge}" FontSize="10"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{local:Loc stats.live.axisNow}" FontSize="10"
                                       Margin="0,0,44,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                        <!-- Wraps, unlike the by-type legend below: project names are as long as the
                             machine's folders and carry a parent segment (T154), so five of them can
                             out-run the plate. Identical to a StackPanel while they fit. -->
                        <WrapPanel x:Name="LegendProjects" Orientation="Horizontal" Margin="0,8,0,0" />

                        <TextBlock Text="{local:Loc stats.throughput.byType}" Margin="0,16,0,0"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Border x:Name="ChartTypes" Height="118" Margin="0,6,0,0" CornerRadius="6" ClipToBounds="True"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{local:Loc stats.live.axisAge}" FontSize="10"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{local:Loc stats.live.axisNow}" FontSize="10"
                                       Margin="0,0,44,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                        <StackPanel x:Name="LegendTypes" Orientation="Horizontal" Margin="0,8,0,0" />

                        <!-- The fourth quantity, stated in words rather than drawn as a fourth line
                             (T107): cache reads are excluded from every rate above, and on real
                             traffic they are two orders of magnitude larger than the work that is
                             drawn. The absence has to be explained where it happens, and this is the
                             per-turn price of a large eager context â€” the link to Context load. -->
                        <TextBlock x:Name="CacheReadNote" Margin="0,10,0,0" FontSize="12"
                                   TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <!-- The slow clock, both windows, for scale against the fast one above. One line
                             each, window named inline: the per-type split of a *window* average belongs
                             on that window's own tab, and repeating it here only cost this pane the
                             height that made it scroll. -->
                        <TextBlock Text="{local:Loc stats.throughput.averages}" Margin="0,16,0,0"
                                   FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{local:Loc stats.tab.session}" FontSize="13" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="TpsHeadT5" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{local:Loc stats.tab.week}" FontSize="13" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="TpsHeadT7" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ SESSIONS (where it went) ============
                     The other three panes answer how much is left and how fast it is going; this one
                     answers where it went, and that is only askable against a list of nameable
                     things (T328). Not a ScrollViewer around a StackPanel like its neighbours: the
                     header row has to stay put while the list under it scrolls, or the columns are
                     labelled only until you look for something. -->
                <TabItem Header="{local:Loc stats.tab.sessions}">
                    <Grid Margin="4,18,14,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{local:Loc stats.sessions.hint}" FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="SessionsCount" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <!-- The heaviest five hours in the range on screen (T332). A
                                     measurement of a window that has closed, which is a different
                                     question from the live one the other tabs answer — and never a
                                     recommendation, because nothing here knows the allowance. -->
                                <TextBlock x:Name="SessionsPeak" FontSize="12" Margin="0,3,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- This pane's own ⓘ, not the footer's (T346). The footer note is about
                                     every number in the window and stands at 1,302 of its 1,350-character
                                     budget in French — 48 characters of room for a fifth surface. This one
                                     is about one column, and it sits where a reader looking at that column
                                     is already looking. Same Block M pattern, same InfoDot style, same
                                     naming rule as T175: a Segoe MDL2 codepoint has no text to derive an
                                     accessible name from, so the title string is both name and tooltip. -->
                                <ToggleButton x:Name="SessionsMethodInfo" Margin="0,0,10,0"
                                              Style="{StaticResource InfoDot}"
                                              ToolTip="{local:Loc stats.sessions.methodTitle}"
                                              AutomationProperties.Name="{local:Loc stats.sessions.methodTitle}"
                                              Content="&#xE946;" />
                                <Popup x:Name="SessionsMethodPopup"
                                       IsOpen="{Binding IsChecked, ElementName=SessionsMethodInfo, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=SessionsMethodInfo}" Placement="Bottom"
                                       VerticalOffset="4" HorizontalOffset="-8"
                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border MaxWidth="520" CornerRadius="8" Padding="16,14" Margin="8"
                                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Direction="270" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="{local:Loc stats.sessions.methodTitle}" FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="SessionsMethodBody" Margin="0,6,0,0" FontSize="12"
                                                       TextWrapping="Wrap" LineHeight="18"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <!-- Bounded by default: the index covers every transcript on disk and the
                                     list opens on the seven days the rest of the window reports on. -->
                                <ComboBox x:Name="SessionsRange" MinWidth="150"
                                          SelectedIndex="0" VerticalAlignment="Center"
                                          AutomationProperties.Name="{local:Loc stats.sessions.range}">
                                    <ComboBoxItem Content="{local:Loc stats.sessions.range7}" />
                                    <ComboBoxItem Content="{local:Loc stats.sessions.range30}" />
                                    <ComboBoxItem Content="{local:Loc stats.sessions.rangeAll}" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- The sixth column is the scrollbar's gutter, widened in code from
                             SystemParameters so the header's columns sit over the rows' rather than
                             a scrollbar's width to the right of them. The list below always shows its
                             scrollbar for the same reason: a gutter that comes and goes moves the
                             rows out from under their own headings. -->

                        <!-- Which kind of work ate the range (T333). Under the count and above the
                             list, because it is a reading about the same rows: the projects strip
                             says which repo, and this says which kind of work inside it. -->
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <!-- Four unlabelled numbers is four numbers nobody can read: seen in the
                                 capture, where tasks, median, total and share were indistinguishable. -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{local:Loc stats.kind.col.tasks}" FontSize="11"
                                           HorizontalAlignment="Right" Margin="0,0,12,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{local:Loc stats.kind.col.median}" FontSize="11"
                                           HorizontalAlignment="Right" Margin="0,0,12,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{local:Loc stats.kind.col.total}" FontSize="11"
                                           HorizontalAlignment="Right" Margin="0,0,12,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="4" Text="{local:Loc stats.kind.col.share}" FontSize="11"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        <ItemsControl x:Name="SessionKinds">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Tasks}" FontSize="12"
                                                   HorizontalAlignment="Right" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Median}" FontSize="12"
                                                   HorizontalAlignment="Right" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Total}" FontSize="12"
                                                   HorizontalAlignment="Right" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Share}" FontSize="12"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                        <Border Grid.Row="3" Margin="0,12,0,0" Padding="8,0,8,6"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="124" />
                                    <ColumnDefinition x:Name="SessionsGutter" Width="0" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{local:Loc stats.sessions.col.project}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Button Grid.Column="1" x:Name="SortByWhen" Style="{StaticResource SortHeader}"
                                        Content="{local:Loc stats.sessions.col.when}"
                                        HorizontalContentAlignment="Left" />
                                <TextBlock Grid.Column="2" Text="{local:Loc stats.sessions.col.duration}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{local:Loc stats.sessions.col.turns}"
                                           FontSize="12" HorizontalAlignment="Right" Margin="0,0,12,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Button Grid.Column="4" x:Name="SortByTokens" Style="{StaticResource SortHeader}"
                                        Content="{local:Loc stats.sessions.col.tokens}"
                                        HorizontalContentAlignment="Right" />
                                <!-- Not a sort header, deliberately: the ranking is the token column's
                                     (T346), and a second ordering over a figure derived from it would
                                     differ only where a conversation ran a dearer model — a distinction
                                     the heading cannot make and the note has to. -->
                                <!-- Stretch plus TextAlignment, not HorizontalAlignment="Right" — T338's
                                     lesson one column over: a right-aligned TextBlock sizes to its
                                     content, so the trimming never fires and the heading overflowed
                                     leftward until it touched "Tokens". Stretch is what makes the column
                                     width the constraint the ellipsis is measured against. -->
                                <TextBlock Grid.Column="5" Text="{local:Loc stats.sessions.col.money}"
                                           FontSize="12" HorizontalAlignment="Stretch" TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Visible"
                                      HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
                            <ItemsControl x:Name="SessionList"
                                          ItemTemplate="{StaticResource SessionRowTemplate}" />
                        </ScrollViewer>

                        <!-- Empty is a sentence, not a frame drawn around nothing â€” and "no
                             transcripts at all" and "none in this range" are different facts. -->
                        <TextBlock x:Name="SessionsEmpty" Grid.Row="4" Margin="8,24,8,0"
                                   FontSize="13" TextWrapping="Wrap" VerticalAlignment="Top"
                                   Visibility="Collapsed"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </TabItem>
            </TabControl>

        </Grid>

        <!-- ===== Footer ===== -->
        <Grid Grid.Row="2" Margin="32,12,32,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- "Updated â€¦" and, beside it, the method behind every number in this window. It used to be
                 six lines of 11px prose pinned under the panes, which is a lot of screen for something
                 you read once â€” it is now on demand, same text, one click (T113). -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ComputedText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <!-- Its content is a Segoe MDL2 codepoint, so there is no text to derive a name from
                     (T175) â€” the button that explains every number in this window announced itself as
                     "button". The tooltip's string is the note's own title; the name is the same one. -->
                <ToggleButton x:Name="MethodInfo" Margin="10,0,0,0" Visibility="Collapsed"
                              Style="{StaticResource InfoDot}"
                              ToolTip="{local:Loc stats.methodTitle}"
                              AutomationProperties.Name="{local:Loc stats.methodTitle}"
                              Content="&#xE946;" />
                <Popup x:Name="MethodPopup"
                       IsOpen="{Binding IsChecked, ElementName=MethodInfo, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=MethodInfo}" Placement="Top"
                       VerticalOffset="-8" HorizontalOffset="-8"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border MaxWidth="560" CornerRadius="8" Padding="16,14" Margin="8"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Direction="270" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{local:Loc stats.methodTitle}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <!-- One headed paragraph per surface, in the order the window shows them
                                 (T170). It was a single run-on TextBlock: 1,276 characters at the worst
                                 translation, 61% of them constant, with the paragraph about this
                                 machine's own evidence buried in the middle of it. -->
                            <ItemsControl x:Name="MethodNote" Margin="0,4,0,0"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Heading}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Body}" Margin="0,2,0,0" FontSize="12"
                                                       TextWrapping="Wrap" LineHeight="18"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="{local:Loc stats.refresh}"
                        MinWidth="92" Padding="14,6" Margin="0,0,8,0"
                        Click="Refresh_Click" />
                <Button x:Name="StatsCloseButton" Content="{local:Loc stats.close}"
                        MinWidth="92" Padding="14,6"
                        Style="{DynamicResource AccentButtonStyle}"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
