<Window x:Class="ClaudeTray.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeTray"
        x:ClassModifier="internal"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        Width="400" Height="200"
        FontFamily="{x:Static local:ToastWindow.BodyFont}">

    <Window.Resources>
        <!-- Round close affordance in the corner. -->
        <Style x:Key="Circle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root carries the entrance slide + fade (set in code-behind). -->
    <Grid x:Name="Root" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideT" Y="44" />
        </Grid.RenderTransform>

        <!-- Card background gradient is set per notification type in code-behind (see ToastTheme). -->
        <Border x:Name="Card" CornerRadius="16" Margin="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.5" Color="#80000000" />
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- Confetti is generated in code-behind and sits above the gradient, below the text. -->
                <Canvas x:Name="Confetti" IsHitTestVisible="False" />

                <Grid Margin="22,16,16,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header: party emoji + headline, close button pinned right. -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <!-- Named, not inherited: the window's stack has no colour glyphs and WPF
                                 falls through to a monochrome outline that looks fine (T227). -->
                            <TextBlock x:Name="Emoji" FontSize="32" VerticalAlignment="Center"
                                       FontFamily="{x:Static local:ToastWindow.EmojiFont}" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <!-- Bounded like the subtitle: the close button sits at the same top-right
                                     corner, and an unbounded title runs straight under it in any language
                                     whose wording is longer than English's (T174). -->
                                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Foreground="White"
                                           TextWrapping="Wrap" MaxWidth="250" />
                                <TextBlock x:Name="Subtitle" FontSize="13" Foreground="#EEFFFFFF"
                                           TextWrapping="Wrap" MaxWidth="270" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="CloseButton" Style="{StaticResource Circle}"
                                Content="✕" Width="26" Height="26" FontSize="11"
                                Background="#22FFFFFF" Foreground="White"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Cursor="Hand" Click="Close_Click" />
                    </Grid>

                    <!-- The good news, shown as available quota filling back up to 100%. QuotaBlock is
                         collapsed for a card that has no quota to talk about (T174) — see the constructor. -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0">
                        <StackPanel x:Name="QuotaBlock">
                            <Grid>
                                <TextBlock x:Name="QuotaLabel" FontSize="13" FontWeight="SemiBold"
                                           Foreground="White" HorizontalAlignment="Left" />
                                <TextBlock x:Name="AvailPct" FontSize="13" FontWeight="SemiBold"
                                           Foreground="White" HorizontalAlignment="Right" />
                            </Grid>
                            <Border Height="10" CornerRadius="5" Background="#33FFFFFF"
                                    Margin="0,6,0,0" ClipToBounds="True">
                                <Border x:Name="Fill" CornerRadius="5" Background="White"
                                        HorizontalAlignment="Stretch" RenderTransformOrigin="0,0">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="FillScale" ScaleX="0.21" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="Caption" FontSize="12" Foreground="#CCFFFFFF"
                                   Margin="0,7,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
