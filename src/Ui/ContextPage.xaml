<!-- A destination of MainWindow rather than a window: the shell owns the chrome (see StatisticsPage). -->
<UserControl x:Class="ClaudeTray.ContextPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeTray"
        x:ClassModifier="internal"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <UserControl.Resources>
        <!-- The rounded surface that holds the project list and the detail pane. -->
        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>

        <!-- Small muted label that titles a pane or a section of the detail. -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- One measured number over its caption, used for the estimated / measured pair. -->
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="StatCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Column header / body cell in the source table. -->
        <Style x:Key="ColHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- One project in the master list: name + a one-line summary, with what a session in it
             costs on the right. -->
        <DataTemplate x:Key="ProjectItemTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Eager}" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <!-- Context-debt grade. A letter is an authority claim, so it always travels with
                         its inputs — the tooltip spells out the tokens and findings behind it. -->
                    <Border Margin="8,0,0,0" CornerRadius="4" Padding="5,1" MinWidth="20"
                            Visibility="{Binding GradeVisibility}"
                            Background="{Binding GradeBrush}" ToolTip="{Binding GradeTip}">
                        <TextBlock Text="{Binding Grade}" FontSize="11" FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ===== The source table's six columns are repeated in the header, the group rows and the
             file rows below. They are explicit pixel widths on purpose: the three templates are
             separate visual trees, so a shared-size scope can't align a `*` first column across
             them, and hand-matched widths stay predictable. ===== -->

        <DataTemplate x:Key="SourceRowTemplate">
            <!-- The negative margin cancels the padding, so the hover highlight bleeds past the text
                 while the columns stay aligned with the header above to the pixel. -->
            <Border Background="Transparent" CornerRadius="4"
                    Padding="5,3" Margin="-5,1,-5,0"
                    MouseDown="SourceRow_MouseDown"
                    ToolTip="{Binding FullPath}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{local:Loc context.action.reveal}" Click="RevealRow_Click" />
                        <MenuItem Header="{local:Loc context.action.open}" Click="OpenRow_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="122" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <!-- Simulate checkbox, then the health dot, both in fixed-width gutters so every
                         label starts at the same x whether or not it has either. -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="13" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Only offered where removing the file would actually free eager context;
                             a checkbox that can't move the gauge would promise a saving that isn't
                             there. -->
                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                  Visibility="{Binding SelectVisibility}"
                                  IsChecked="{Binding Selected, Mode=OneTime}"
                                  Click="SimulateToggle_Click"
                                  ToolTip="{local:Loc context.sim.hint}" />
                        <Ellipse Grid.Column="1" Width="6" Height="6"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Fill="{Binding DotBrush}" Visibility="{Binding DotVisibility}"
                                 ToolTip="{Binding DotTip}" />
                        <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>

                    <!-- The load chip: what this file actually costs per request. For a skill or an
                         agent it has to say both things at once — the body is lazy, the description
                         is in the always-loaded index — which is what "lazy + index" means. -->
                    <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                            CornerRadius="4" Padding="6,1" Background="{Binding ChipBackground}"
                            ToolTip="{Binding ChipTip}">
                        <TextBlock Text="{Binding Mode}" FontSize="11"
                                   Foreground="{Binding ChipForeground}" />
                    </Border>

                    <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Cell}" />
                    <TextBlock Grid.Column="3" Text="{Binding Tokens}" Style="{StaticResource Cell}" />
                    <TextBlock Grid.Column="4" Text="{Binding Eager}" Style="{StaticResource Cell}"
                               FontWeight="{Binding EagerWeight}" />
                    <!-- Evidence of use, for skills and agents. "—" means unknown, never "unused". -->
                    <TextBlock Grid.Column="5" Text="{Binding Used}" Style="{StaticResource Cell}"
                               FontWeight="{Binding UsedWeight}" ToolTip="{Binding UsedTip}"
                               Foreground="{Binding UsedBrush}" />
                    <TextBlock Grid.Column="6" Text="{Binding Modified}" Style="{StaticResource Cell}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SourceGroupTemplate">
            <StackPanel Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="122" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <!-- Spans the Load column too: a group has no single load mode, so that cell is
                         empty and the header may as well use the room (kind names are long once
                         translated). -->
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Header}"
                               FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Cell}" />
                    <TextBlock Grid.Column="3" Text="{Binding Tokens}" Style="{StaticResource Cell}" />
                    <TextBlock Grid.Column="4" Text="{Binding Eager}" Style="{StaticResource Cell}"
                               FontWeight="SemiBold" />
                </Grid>
                <Border Height="1" Margin="0,5,0,0"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SourceRowTemplate}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><!-- header -->
            <RowDefinition Height="*" />   <!-- master / detail -->
            <RowDefinition Height="Auto" /><!-- footer -->
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <StackPanel Grid.Row="0" Margin="28,22,28,0">
            <TextBlock Text="{local:Loc context.header}" FontSize="21" FontWeight="Bold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap"
                       Text="{local:Loc context.subtitle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- ===== Master / detail ===== -->
        <Grid Grid.Row="1" Margin="26,16,26,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Shown instead of the panes while scanning, on a scan error, or with nothing to show. -->
            <TextBlock x:Name="ContextStatusText" Grid.ColumnSpan="2" Margin="4,20,4,0"
                       FontSize="13.5" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- Master: one row per ~/.claude/projects directory, heaviest first. -->
            <Border x:Name="MasterPane" Grid.Column="0" Style="{StaticResource GroupCard}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{local:Loc context.projects}"
                               Style="{StaticResource SectionHeader}" Margin="2,0,0,8" />
                    <ListBox x:Name="ProjectList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ItemTemplate="{StaticResource ProjectItemTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </Border>

            <!-- Detail: what a session in the selected project loads. -->
            <Border x:Name="DetailPane" Grid.Column="1" Margin="14,0,0,0"
                    Style="{StaticResource GroupCard}">
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"
                              Padding="18,16,18,18">
                  <StackPanel>
                    <!-- ===== "All projects": the problems that are invisible inside any single
                         project — duplication across worktree siblings, dead project directories,
                         and which projects actually carry the weight. Filled by BuildAllProjects. -->
                    <StackPanel x:Name="AllDetail" Visibility="Collapsed">
                        <TextBlock Text="{local:Loc context.all.title}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="AllSubtitle" FontSize="12" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock x:Name="AllFootprint" Style="{StaticResource StatValue}" />
                                <TextBlock Text="{local:Loc context.all.footprint}"
                                           Style="{StaticResource StatCaption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock x:Name="AllShared" Style="{StaticResource StatValue}" />
                                <TextBlock Text="{local:Loc context.all.shared}"
                                           Style="{StaticResource StatCaption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="AllHeaviestValue" Style="{StaticResource StatValue}" />
                                <TextBlock Text="{local:Loc context.all.heaviestStat}"
                                           Style="{StaticResource StatCaption}" />
                                <TextBlock x:Name="AllHeaviestName" Style="{StaticResource StatCaption}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="AllNote" Margin="0,12,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <TextBlock Text="{local:Loc context.all.heaviest}" Margin="0,22,0,0"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{local:Loc context.all.heaviestHint}" Margin="0,3,0,0"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <StackPanel x:Name="AllHeaviestList" Margin="0,8,0,0" />

                        <TextBlock Text="{local:Loc context.all.crossProject}" Margin="0,24,0,0"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <StackPanel x:Name="AllIssuesList" Margin="0,8,0,0" />

                        <Border Margin="0,18,0,0" CornerRadius="8" Padding="12,10"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock x:Name="AllFixCount" FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="AllFixHint" FontSize="11.5" Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="AllCopyPromptButton" Grid.Column="1"
                                        Content="{local:Loc context.fix.copy}"
                                        VerticalAlignment="Center" Padding="14,7" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ProjectDetail">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ProjectTitle" FontSize="17" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Border x:Name="GradeChip" Margin="10,0,0,0" CornerRadius="5" Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="GradeText" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ProjectPath" FontSize="12" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <!-- ===== The hero: one honest bar of session zero against the context
                             window, split by source, with what the transcripts actually measured
                             overlaid as a tick. Both grids are filled in code (see BuildGauge) —
                             star-weighted columns keep every position correct on resize with no
                             re-layout code. ===== -->
                        <Grid Margin="0,20,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><!-- measured tick, above the bar -->
                                <RowDefinition Height="Auto" /><!-- the bar itself -->
                            </Grid.RowDefinitions>
                            <Grid x:Name="GaugeTick" Grid.Row="0" Height="26" />
                            <Border x:Name="GaugeBar" Grid.Row="1" Height="24" CornerRadius="6"
                                    ClipToBounds="True"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="GaugeCaption" Margin="0,10,0,0" FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <!-- Every segment is direct-labeled here with its own number, so identity is
                             never carried by color alone. -->
                        <WrapPanel x:Name="GaugeLegend" Margin="0,9,0,0" />

                        <!-- ===== Drift: bloat arrives one memory at a time, so the trend is the only
                             thing that makes it noticeable. Collapsed until there is history. ===== -->
                        <Grid x:Name="DriftRow" Visibility="Collapsed" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas x:Name="DriftSpark" Grid.Column="0" Width="132" Height="26"
                                    VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock x:Name="DriftText" Grid.Column="1" FontSize="12"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <!-- ===== What-if: what the ticked rows would give back. Collapsed until
                             something is ticked. Nothing here writes to disk — the gauge above is
                             simply redrawn without the ticked sources. ===== -->
                        <Border x:Name="SimBanner" Visibility="Collapsed" Margin="0,14,0,0"
                                CornerRadius="8" Padding="12,10"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock x:Name="SimHeadline" FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SimDetail" FontSize="11.5" Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="SimClearButton" Grid.Column="1"
                                        Content="{local:Loc context.sim.clear}"
                                        VerticalAlignment="Center" Padding="12,5" />
                            </Grid>
                        </Border>

                        <!-- The two honest numbers, side by side: what the files on disk add up to,
                             and what recent sessions actually reported. They are not the same kind of
                             number — the caption below says why. -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock x:Name="EstimatedValue" Style="{StaticResource StatValue}" />
                                <TextBlock Text="{local:Loc context.sessionZero}"
                                           Style="{StaticResource StatCaption}" />
                                <TextBlock x:Name="EstimatedParts" Style="{StaticResource StatCaption}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="ObservedValue" Style="{StaticResource StatValue}" />
                                <TextBlock Text="{local:Loc context.observed}"
                                           Style="{StaticResource StatCaption}" />
                                <TextBlock x:Name="ObservedParts" Style="{StaticResource StatCaption}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{local:Loc context.baseNote}" Margin="0,12,0,0"
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <!-- ===== The one action that acts on findings: hand them to Claude. The
                             window itself never edits ~/.claude (§I.4) — it writes down what it
                             measured and lets the tool that can read the files do the editing. ===== -->
                        <Border Margin="0,20,0,0" CornerRadius="8" Padding="12,10"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock x:Name="FixCount" FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="FixHint" FontSize="11.5" Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="CopyPromptButton" Grid.Column="1"
                                        Content="{local:Loc context.fix.copy}"
                                        VerticalAlignment="Center" Padding="14,7" />
                            </Grid>
                        </Border>

                        <!-- Row actions + sort. The hint carries its own discoverability: a row's
                             actions live on its context menu, which nothing else would advertise. -->
                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{local:Loc context.sim.tableHint}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{local:Loc context.action.hint}" Margin="0,2,0,0"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{local:Loc context.sort.label}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="SortBox" MinWidth="150" SelectedIndex="0">
                                    <ComboBoxItem Content="{local:Loc context.sort.eager}" />
                                    <ComboBoxItem Content="{local:Loc context.sort.tokens}" />
                                    <ComboBoxItem Content="{local:Loc context.sort.age}" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Column header for both source tables below. -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="122" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{local:Loc context.col.source}"
                                       Style="{StaticResource SectionHeader}" />
                            <TextBlock Grid.Column="1" Text="{local:Loc context.col.mode}"
                                       Style="{StaticResource ColHeader}" TextAlignment="Left" />
                            <TextBlock Grid.Column="2" Text="{local:Loc context.col.size}"
                                       Style="{StaticResource ColHeader}" />
                            <TextBlock Grid.Column="3" Text="{local:Loc context.col.tokens}"
                                       Style="{StaticResource ColHeader}" />
                            <TextBlock Grid.Column="4" Text="{local:Loc context.col.eager}"
                                       Style="{StaticResource ColHeader}" />
                            <TextBlock Grid.Column="5" Text="{local:Loc context.col.used}"
                                       Style="{StaticResource ColHeader}" />
                            <TextBlock Grid.Column="6" Text="{local:Loc context.col.modified}"
                                       Style="{StaticResource ColHeader}" />
                        </Grid>

                        <ItemsControl x:Name="ProjectGroups"
                                      ItemTemplate="{StaticResource SourceGroupTemplate}" />

                        <TextBlock x:Name="SharedHeader" Text="{local:Loc context.shared}"
                                   Margin="0,26,0,0" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{local:Loc context.shared.note}" Margin="0,3,0,0"
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ItemsControl x:Name="SharedGroups"
                                      ItemTemplate="{StaticResource SourceGroupTemplate}" />
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Footer: what the scan cost, and the two actions ===== -->
        <Grid Grid.Row="2" Margin="28,16,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ScanInfo" Grid.Column="0" VerticalAlignment="Center"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,16,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RescanButton" Content="{local:Loc context.refresh}"
                        MinWidth="104" Padding="14,7" Margin="0,0,10,0" />
                <Button x:Name="ContextCloseButton" Content="{local:Loc context.close}"
                        MinWidth="104" Padding="14,7" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
