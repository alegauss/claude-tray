<!-- A destination of MainWindow rather than a window: the shell owns the chrome (see StatisticsPage).
     The sidebar below is this page's *own* second level — the six settings pages. -->
<UserControl x:Class="ClaudeTray.SettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeTray"
        x:ClassModifier="internal"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <UserControl.Resources>
        <!-- A clickable info card on the About page: lifts and accents its border on hover so it
             reads as a link, not a static panel. The URL is carried in each card's Tag. -->
        <Style x:Key="LinkCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Translucent pill used for the version / platform tags over the hero gradient. -->
        <Style x:Key="HeroChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#30FFFFFF" />
        </Style>

        <!-- ===== Settings-row pattern (Fluent "SettingsCard"): a section is a small caps header
             over a GroupCard whose children are SettingsRows (label+description left, control right),
             split by RowDividers. ===== -->

        <!-- Small muted label that titles a group of rows. -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,22,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- The rounded container that holds one or more rows. -->
        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>

        <!-- A hairline between rows, inset to align with the rows' text. -->
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <!-- The row itself: title + optional description on the left, trailing control on the right. -->
        <Style TargetType="{x:Type local:SettingsRow}">
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:SettingsRow}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="{TemplateBinding Header}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="Desc" Text="{TemplateBinding Description}"
                                           Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="1"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- No description → hide the caption line so the row stays compact. -->
                            <Trigger Property="Description" Value="">
                                <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Read-only value pair, used as the trailing "control" of the information rows on the
             System information page: the reading itself, and a muted qualifier under it (the raw API
             tier behind a friendly plan name, a path's origin, an install method…). ===== -->
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="290" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="ValueSubText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="290" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- A pill toggle switch (templated ToggleButton) matching the Fluent accent — the trailing
             control for every boolean setting. IsChecked drives the track color and thumb position. -->
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                                SnapsToDevicePixels="True"
                                Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="12" Height="12"
                                     VerticalAlignment="Center" HorizontalAlignment="Left"
                                     Margin="4,0,0,0"
                                     Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                                <Setter TargetName="Thumb" Property="Width" Value="14" />
                                <Setter TargetName="Thumb" Property="Height" Value="14" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Two columns: a fixed navigation sidebar and a content pane that fills the rest.
         The whole layout is declared here (declarative XAML) — no imperative z-order stacking,
         so what you read is exactly what renders. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <!-- No "Settings" heading over the list: the nav strip above already names this
                 destination, and the two sat one under the other saying the same word. -->
            <StackPanel Margin="12,16,12,12">
                <!-- Nav items. Selection (accent bar + subtle background) is toggled in code-behind;
                     a transparent background keeps the whole row clickable even when unselected. -->
                <Border x:Name="NavGeneral" CornerRadius="6" Height="40" Margin="0,0,0,4"
                        Background="Transparent" Cursor="Hand"
                        MouseLeftButtonUp="Nav_Click" Tag="General">
                    <Grid>
                        <Border x:Name="AccentGeneral" Width="3" CornerRadius="2"
                                HorizontalAlignment="Left" Margin="2,8,0,8"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="{local:Loc settings.nav.general}" VerticalAlignment="Center"
                                   Margin="16,0,0,0" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>

                <Border x:Name="NavDisplay" CornerRadius="6" Height="40" Margin="0,0,0,4"
                        Background="Transparent" Cursor="Hand"
                        MouseLeftButtonUp="Nav_Click" Tag="Display">
                    <Grid>
                        <Border x:Name="AccentDisplay" Width="3" CornerRadius="2"
                                HorizontalAlignment="Left" Margin="2,8,0,8"
                                Visibility="Collapsed"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="{local:Loc settings.nav.display}" VerticalAlignment="Center"
                                   Margin="16,0,0,0" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>

                <Border x:Name="NavClaudeCode" CornerRadius="6" Height="40" Margin="0,0,0,4"
                        Background="Transparent" Cursor="Hand"
                        MouseLeftButtonUp="Nav_Click" Tag="ClaudeCode">
                    <Grid>
                        <Border x:Name="AccentClaudeCode" Width="3" CornerRadius="2"
                                HorizontalAlignment="Left" Margin="2,8,0,8"
                                Visibility="Collapsed"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="{local:Loc settings.nav.claudeCode}" VerticalAlignment="Center"
                                   Margin="16,0,0,0" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>

                <Border x:Name="NavNotifications" CornerRadius="6" Height="40" Margin="0,0,0,4"
                        Background="Transparent" Cursor="Hand"
                        MouseLeftButtonUp="Nav_Click" Tag="Notifications">
                    <Grid>
                        <Border x:Name="AccentNotifications" Width="3" CornerRadius="2"
                                HorizontalAlignment="Left" Margin="2,8,0,8"
                                Visibility="Collapsed"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="{local:Loc settings.nav.notifications}" VerticalAlignment="Center"
                                   Margin="16,0,0,0" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>

                <Border x:Name="NavSystem" CornerRadius="6" Height="40" Margin="0,0,0,4"
                        Background="Transparent" Cursor="Hand"
                        MouseLeftButtonUp="Nav_Click" Tag="System">
                    <Grid>
                        <Border x:Name="AccentSystem" Width="3" CornerRadius="2"
                                HorizontalAlignment="Left" Margin="2,8,0,8"
                                Visibility="Collapsed"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="{local:Loc settings.nav.system}" VerticalAlignment="Center"
                                   Margin="16,0,0,0" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>

                <Border x:Name="NavAbout" CornerRadius="6" Height="40"
                        Background="Transparent" Cursor="Hand"
                        MouseLeftButtonUp="Nav_Click" Tag="About">
                    <Grid>
                        <Border x:Name="AccentAbout" Width="3" CornerRadius="2"
                                HorizontalAlignment="Left" Margin="2,8,0,8"
                                Visibility="Collapsed"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="{local:Loc settings.nav.about}" VerticalAlignment="Center"
                                   Margin="16,0,0,0" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== Content host: a page area (General / About overlaid, visibility-toggled) + a
             pinned footer shared by both pages. ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />   <!-- page -->
                <RowDefinition Height="Auto" /><!-- footer -->
            </Grid.RowDefinitions>

            <!-- ========================= GENERAL PAGE =========================
                 Every setting is a SettingsRow (label+description left, control right) grouped
                 under a small caps section header inside a GroupCard. -->
            <Grid x:Name="GeneralPane" Grid.Row="0" Margin="32,28,32,0">
                <!-- The settings sections scroll as a group; the footer below stays pinned, so adding
                     sections never clips the Save/Cancel buttons. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="{local:Loc settings.general.title}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{local:Loc settings.general.subtitle}"
                                   Margin="0,2,0,4" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <!-- ===== Refresh ===== -->
                        <TextBlock Text="{local:Loc settings.general.refresh}" Style="{StaticResource SectionHeader}" Margin="2,16,0,8" />
                        <Border Style="{StaticResource GroupCard}">
                            <local:SettingsRow Header="{local:Loc settings.general.interval}"
                                               Description="{local:Loc settings.general.intervalDesc}">
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="IntervalSlider" Width="170" VerticalAlignment="Center"
                                            Minimum="0.5" Maximum="60"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            ValueChanged="IntervalSlider_ValueChanged" />
                                    <TextBlock x:Name="IntervalValue" VerticalAlignment="Center"
                                               MinWidth="72" Margin="14,0,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </local:SettingsRow>
                        </Border>

                        <!-- Each refresh is a 1-token Haiku call (the "heartbeat"). This caption recalculates
                             the consumption live as the slider moves, so the cost of the chosen cadence is explicit. -->
                        <TextBlock x:Name="CostEstimate"
                                   Margin="2,10,2,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <!-- ===== Language ===== -->
                        <TextBlock Text="{local:Loc settings.general.language}" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource GroupCard}">
                            <local:SettingsRow Header="{local:Loc settings.general.appLanguage}"
                                               Description="{local:Loc settings.general.appLanguageDesc}">
                                <ComboBox x:Name="LanguageCombo" MinWidth="180" VerticalAlignment="Center" />
                            </local:SettingsRow>
                        </Border>

                        <!-- ===== Startup ===== -->
                        <TextBlock Text="{local:Loc settings.general.startup}" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource GroupCard}" Margin="0,0,0,4">
                            <local:SettingsRow Header="{local:Loc settings.general.startWithWindows}"
                                               Description="{local:Loc settings.general.startWithWindowsDesc}">
                                <ToggleButton x:Name="StartupCheck" Style="{StaticResource ToggleSwitch}" />
                            </local:SettingsRow>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========================= DISPLAY PAGE =========================
                 How the usage reads on the tray icon and its tooltip. -->
            <Grid x:Name="DisplayPane" Grid.Row="0" Margin="32,28,32,0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="{local:Loc settings.display.title}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{local:Loc settings.display.subtitle}"
                                   Margin="0,2,0,4" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Border Style="{StaticResource GroupCard}" Margin="0,16,0,4">
                            <StackPanel>
                                <local:SettingsRow Header="{local:Loc settings.display.showPct}"
                                                   Description="{local:Loc settings.display.showPctDesc}">
                                    <ToggleButton x:Name="ShowPctCheck" Style="{StaticResource ToggleSwitch}" />
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.display.showRemaining}"
                                                   Description="{local:Loc settings.display.showRemainingDesc}">
                                    <ToggleButton x:Name="ShowRemainingCheck" Style="{StaticResource ToggleSwitch}" />
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.display.flashWarn}"
                                                   Description="{local:Loc settings.display.flashWarnDesc}">
                                    <ToggleButton x:Name="FlashCheck" Style="{StaticResource ToggleSwitch}" />
                                </local:SettingsRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========================= CLAUDE CODE PAGE =========================
                 Where Claude Code launches from, and how the tray behaves while signed out. -->
            <Grid x:Name="ClaudeCodePane" Grid.Row="0" Margin="32,28,32,0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="{local:Loc settings.cc.title}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{local:Loc settings.cc.subtitle}"
                                   Margin="0,2,0,4" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Border Style="{StaticResource GroupCard}" Margin="0,16,0,4">
                            <StackPanel>
                                <local:SettingsRow Header="{local:Loc settings.cc.workDir}"
                                                   Description="{local:Loc settings.cc.workDirDesc}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="DirectoryBox" Width="200"
                                                 VerticalContentAlignment="Center" Padding="8,5" />
                                        <Button x:Name="BrowseButton" Content="{local:Loc settings.cc.browse}"
                                                MinWidth="92" Padding="14,5" Margin="8,0,0,0"
                                                Click="Browse_Click" />
                                    </StackPanel>
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.cc.autoOpen}"
                                                   Description="{local:Loc settings.cc.autoOpenDesc}">
                                    <ToggleButton x:Name="AutoOpenCheck" Style="{StaticResource ToggleSwitch}" />
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.cc.retry}"
                                                   Description="{local:Loc settings.cc.retryDesc}">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider x:Name="RetrySlider" Width="170" VerticalAlignment="Center"
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                ValueChanged="RetrySlider_ValueChanged" />
                                        <TextBlock x:Name="RetryValue" VerticalAlignment="Center"
                                                   MinWidth="72" Margin="14,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </local:SettingsRow>
                            </StackPanel>
                        </Border>

                        <!-- ===== Profiles =====
                             A profile is a Claude Code configuration folder (CLAUDE_CONFIG_DIR): its own
                             login, projects, memory and settings. The editor lives here, on the page
                             about launching Claude Code, because that is what a profile decides — and
                             because this page has the Save button. Nothing here writes into a config
                             dir; the tray only remembers which ones to offer, and launches into them. -->
                        <TextBlock Text="{local:Loc settings.cc.profiles}" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource GroupCard}" Margin="0,0,0,4">
                            <StackPanel>
                                <local:SettingsRow Header="{local:Loc settings.cc.profile}"
                                                   Description="{local:Loc settings.cc.profileDesc}">
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="ProfileCombo" MinWidth="170" VerticalAlignment="Center"
                                                  SelectionChanged="Profile_Changed" />
                                        <Button x:Name="ProfileAddButton" Content="{local:Loc settings.cc.profileAdd}"
                                                MinWidth="92" Padding="14,5" Margin="8,0,0,0"
                                                Click="ProfileAdd_Click" />
                                        <Button x:Name="ProfileRemoveButton" Content="{local:Loc settings.cc.profileRemove}"
                                                MinWidth="92" Padding="14,5" Margin="8,0,0,0"
                                                Click="ProfileRemove_Click" />
                                    </StackPanel>
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <!-- Renaming is just editing this box: no dialog, and Save persists it
                                     with everything else on the page. -->
                                <local:SettingsRow x:Name="ProfileNameRow"
                                                   Header="{local:Loc settings.cc.profileName}"
                                                   Description="{local:Loc settings.cc.profileNameDesc}">
                                    <TextBox x:Name="ProfileNameBox" Width="200"
                                             VerticalContentAlignment="Center" Padding="8,5"
                                             TextChanged="ProfileName_Changed" />
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow x:Name="ProfileWorkDirRow"
                                                   Header="{local:Loc settings.cc.profileWorkDir}"
                                                   Description="{local:Loc settings.cc.profileWorkDirDesc}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="ProfileWorkDirBox" Width="200"
                                                 VerticalContentAlignment="Center" Padding="8,5"
                                                 TextChanged="ProfileWorkDir_Changed" />
                                        <Button x:Name="ProfileWorkDirBrowse" Content="{local:Loc settings.cc.browse}"
                                                MinWidth="92" Padding="14,5" Margin="8,0,0,0"
                                                Click="ProfileWorkDirBrowse_Click" />
                                    </StackPanel>
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.cc.profileConfigDir}"
                                                   Description="{local:Loc settings.cc.profileConfigDirDesc}">
                                    <StackPanel>
                                        <TextBlock x:Name="ProfileConfigDirText" Style="{StaticResource ValueText}" />
                                        <TextBlock x:Name="ProfileStatusText" Style="{StaticResource ValueSubText}" />
                                    </StackPanel>
                                </local:SettingsRow>

                                <Border x:Name="ProfileTerminalDivider" Style="{StaticResource RowDivider}" />

                                <!-- T143: the cheap option IMPROVEMENTS.md §X.4 settled on — a copyable
                                     command the user runs themselves, not a toggle the app owns. Setting
                                     CLAUDE_CONFIG_DIR at the user-environment level would reach every
                                     Claude Code session on the machine, including ones the tray never
                                     launches and never sees, so the tray only shows the command and
                                     states the consequence — it never runs it. Hidden for the default
                                     profile: that folder is already what a bare `claude` uses, and T136
                                     found that pointing CLAUDE_CONFIG_DIR *at* it makes Claude Code read
                                     the wrong .claude.json. -->
                                <local:SettingsRow x:Name="ProfileTerminalRow"
                                                   Header="{local:Loc settings.cc.profileTerminal}"
                                                   Description="{local:Loc settings.cc.profileTerminalDesc}">
                                    <StackPanel MaxWidth="290">
                                        <TextBlock x:Name="ProfileTerminalCommand" Style="{StaticResource ValueText}"
                                                   FontFamily="Consolas" FontSize="12.5" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <TextBlock x:Name="ProfileTerminalHint" VerticalAlignment="Center"
                                                       Margin="0,0,12,0" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Button x:Name="ProfileTerminalCopyButton" MinWidth="90" Padding="14,5"
                                                    Content="{local:Loc settings.cc.profileTerminalCopy}"
                                                    Click="ProfileTerminalCopy_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </local:SettingsRow>

                            </StackPanel>
                        </Border>

                        <TextBlock Margin="2,10,2,4" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{local:Loc settings.cc.profileNote}" />

                        <!-- ===== All profiles (T156) =====
                             Both rows below are single settings for the app, not fields of the profile
                             selected above — and inside that card, one row from the combo, they read as
                             the selected profile's own. They are hidden together with their header on a
                             one-profile machine: auto-follow has nowhere to follow to, and there is no
                             choice for the environment to carry (T126, T145). -->
                        <TextBlock x:Name="ProfilesGlobalHeader"
                                   Text="{local:Loc settings.cc.profilesGlobal}"
                                   Style="{StaticResource SectionHeader}" />
                        <Border x:Name="ProfilesGlobalCard" Style="{StaticResource GroupCard}" Margin="0,0,0,4">
                            <StackPanel>
                                <!-- Auto-follow (T126). -->
                                <local:SettingsRow Header="{local:Loc settings.cc.followActive}"
                                                   Description="{local:Loc settings.cc.followActiveDesc}">
                                    <ToggleButton x:Name="FollowActiveCheck" Style="{StaticResource ToggleSwitch}" />
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <!-- T145: the one setting that writes outside this app's own file — the
                                     user-scope CLAUDE_CONFIG_DIR, so a hand-picked profile reaches
                                     sessions the tray never launches. Off by default, and the value
                                     under it is the live reading, so the row always shows what the
                                     environment actually says rather than what the toggle intends. -->
                                <local:SettingsRow Header="{local:Loc settings.cc.envSync}"
                                                   Description="{local:Loc settings.cc.envSyncDesc}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="EnvSyncValue" VerticalAlignment="Center"
                                                   Margin="0,0,14,0" MaxWidth="260"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ToggleButton x:Name="EnvSyncCheck" Style="{StaticResource ToggleSwitch}" />
                                    </StackPanel>
                                </local:SettingsRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========================= NOTIFICATIONS PAGE =========================
                 Same SettingsRow pattern: each toggle is a row, and each routine reset's
                 "minimum usage to notify" threshold is its own row right below, dimmed
                 (IsEnabled-bound) while its toggle is off. -->
            <Grid x:Name="NotificationsPane" Grid.Row="0" Margin="32,28,32,0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="{local:Loc settings.notif.title}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{local:Loc settings.notif.subtitle}"
                                   Margin="0,2,0,4" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <!-- ===== Routine resets ===== -->
                        <TextBlock Text="{local:Loc settings.notif.routine}" Style="{StaticResource SectionHeader}" Margin="2,16,0,8" />
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <local:SettingsRow Header="{local:Loc settings.notif.weekly}"
                                                   Description="{local:Loc settings.notif.weeklyDesc}">
                                    <ToggleButton x:Name="NotifyWeeklyCheck" Style="{StaticResource ToggleSwitch}" />
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.notif.weeklyMin}"
                                                   Description="{local:Loc settings.notif.weeklyMinDesc}"
                                                   IsEnabled="{Binding IsChecked, ElementName=NotifyWeeklyCheck}">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider x:Name="WeeklyMinSlider" Width="150" VerticalAlignment="Center"
                                                Minimum="0" Maximum="100"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="WeeklyMinSlider_ValueChanged" />
                                        <TextBlock x:Name="WeeklyMinValue" VerticalAlignment="Center"
                                                   MinWidth="40" Margin="14,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.notif.session}"
                                                   Description="{local:Loc settings.notif.sessionDesc}">
                                    <ToggleButton x:Name="NotifySessionCheck" Style="{StaticResource ToggleSwitch}" />
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.notif.sessionMin}"
                                                   Description="{local:Loc settings.notif.sessionMinDesc}"
                                                   IsEnabled="{Binding IsChecked, ElementName=NotifySessionCheck}">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider x:Name="SessionMinSlider" Width="150" VerticalAlignment="Center"
                                                Minimum="0" Maximum="100"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="SessionMinSlider_ValueChanged" />
                                        <TextBlock x:Name="SessionMinValue" VerticalAlignment="Center"
                                                   MinWidth="40" Margin="14,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </local:SettingsRow>
                            </StackPanel>
                        </Border>

                        <!-- ===== Context load ===== -->
                        <TextBlock Text="{local:Loc settings.notif.context}" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource GroupCard}" Margin="0,0,0,4">
                            <StackPanel>
                                <local:SettingsRow Header="{local:Loc settings.notif.contextGrowth}"
                                                   Description="{local:Loc settings.notif.contextGrowthDesc}">
                                    <ToggleButton x:Name="NotifyContextCheck" Style="{StaticResource ToggleSwitch}" />
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.notif.contextThreshold}"
                                                   Description="{local:Loc settings.notif.contextThresholdDesc}"
                                                   IsEnabled="{Binding IsChecked, ElementName=NotifyContextCheck}">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider x:Name="ContextThresholdSlider" Width="150" VerticalAlignment="Center"
                                                Minimum="2000" Maximum="40000"
                                                TickFrequency="1000" IsSnapToTickEnabled="True"
                                                ValueChanged="ContextThresholdSlider_ValueChanged" />
                                        <TextBlock x:Name="ContextThresholdValue" VerticalAlignment="Center"
                                                   MinWidth="52" Margin="14,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </local:SettingsRow>
                            </StackPanel>
                        </Border>

                        <!-- ===== Anomaly alerts ===== -->
                        <TextBlock Text="{local:Loc settings.notif.anomalies}" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource GroupCard}" Margin="0,0,0,4">
                            <local:SettingsRow Header="{local:Loc settings.notif.unexpected}"
                                               Description="{local:Loc settings.notif.unexpectedDesc}">
                                <ToggleButton x:Name="NotifyResetCheck" Style="{StaticResource ToggleSwitch}" />
                            </local:SettingsRow>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========================= SYSTEM INFORMATION PAGE =========================
                 Read-only. Every reading comes from what Claude Code already keeps on disk
                 (ClaudeAccount) plus this process's own environment — no API call, no write.
                 Rows are label↔value pairs in the same GroupCard pattern as the settings pages;
                 the values are filled in code-behind (LoadSystemInfo). -->
            <Grid x:Name="SystemPane" Grid.Row="0" Margin="32,28,32,0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="{local:Loc settings.sys.title}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{local:Loc settings.sys.subtitle}"
                                   Margin="0,2,0,4" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <!-- Profile picker — shown only when this machine has more than one Claude Code
                             config dir. Changing it re-renders every row below from that profile's own
                             files; it does not switch anything in Claude Code itself. -->
                        <Border x:Name="SysProfileCard" Style="{StaticResource GroupCard}"
                                Margin="0,18,0,0" Visibility="Collapsed">
                            <local:SettingsRow Header="{local:Loc settings.sys.profile}"
                                               Description="{local:Loc settings.sys.profileDesc}">
                                <!-- Count under the picker, like every other value/qualifier pair on
                                     this page, so the row's description keeps its width. -->
                                <StackPanel>
                                    <ComboBox x:Name="SysProfileCombo" MinWidth="200"
                                              HorizontalAlignment="Right"
                                              SelectionChanged="SysProfile_Changed" />
                                    <TextBlock x:Name="SysProfileCount" Style="{StaticResource ValueSubText}" />
                                </StackPanel>
                            </local:SettingsRow>
                        </Border>

                        <!-- ===== Claude account ===== -->
                        <TextBlock Text="{local:Loc settings.sys.account}" Style="{StaticResource SectionHeader}" Margin="2,16,0,8" />

                        <!-- Shown instead of the card when nothing on disk identifies an account
                             (fresh install, API-key/Bedrock/Vertex setup, or a signed-out machine). -->
                        <Border x:Name="SysNoAccountCard" Style="{StaticResource GroupCard}" Visibility="Collapsed">
                            <TextBlock Margin="16,14" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{local:Loc settings.sys.noAccount}" />
                        </Border>

                        <!-- Shown when this profile's sessions do NOT draw on the subscription (an API
                             key, Bedrock, Vertex): the tray's percentage then describes a quota nothing
                             is spending. Accent-bordered because it contradicts the number beside it. -->
                        <Border x:Name="SysAuthWarnCard" Visibility="Collapsed"
                                CornerRadius="8" Padding="16,13" Margin="0,0,0,10"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                            <!-- Grid, not a horizontal StackPanel: a StackPanel measures children with
                                 infinite width, so wrapping text would be clipped at the card's edge
                                 instead of wrapping to it. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚠" FontSize="18"
                                           VerticalAlignment="Top" Margin="0,0,12,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="SysAuthWarnTitle" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SysAuthWarnBody" Margin="0,4,0,0" TextWrapping="Wrap"
                                               FontSize="12" LineHeight="17"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="SysAccountCard" Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <local:SettingsRow Header="{local:Loc settings.sys.plan}"
                                                   Description="{local:Loc settings.sys.planDesc}">
                                    <StackPanel>
                                        <TextBlock x:Name="SysPlan" Style="{StaticResource ValueText}" />
                                        <TextBlock x:Name="SysPlanTier" Style="{StaticResource ValueSubText}" />
                                    </StackPanel>
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <!-- Which credentials the sessions in this profile actually use. Inferred
                                     from files + environment on render; [Check] asks the CLI itself. -->
                                <local:SettingsRow Header="{local:Loc settings.sys.auth}"
                                                   Description="{local:Loc settings.sys.authDesc}">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="SysAuth" Style="{StaticResource ValueText}" />
                                            <TextBlock x:Name="SysAuthSource" Style="{StaticResource ValueSubText}" />
                                        </StackPanel>
                                        <Button x:Name="SysAuthCheck" MinWidth="86" Padding="12,5"
                                                Margin="14,0,0,0" VerticalAlignment="Center"
                                                Click="SysAuthCheck_Click"
                                                Content="{local:Loc settings.sys.authCheck}" />
                                    </StackPanel>
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.sys.holder}"
                                                   Description="{local:Loc settings.sys.holderDesc}">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="SysHolder" Style="{StaticResource ValueText}" />
                                            <TextBlock x:Name="SysHolderMail" Style="{StaticResource ValueSubText}" />
                                        </StackPanel>
                                        <!-- Masked by default: this page is what ends up in a screenshot
                                             attached to a bug report. -->
                                        <Button x:Name="SysRevealButton" MinWidth="86" Padding="12,5"
                                                Margin="14,0,0,0" VerticalAlignment="Center"
                                                Click="SysReveal_Click"
                                                Content="{local:Loc settings.sys.reveal}" />
                                    </StackPanel>
                                </local:SettingsRow>

                                <Border x:Name="SysOrgDivider" Style="{StaticResource RowDivider}" />

                                <local:SettingsRow x:Name="SysOrgRow"
                                                   Header="{local:Loc settings.sys.org}"
                                                   Description="{local:Loc settings.sys.orgDesc}">
                                    <StackPanel>
                                        <TextBlock x:Name="SysOrg" Style="{StaticResource ValueText}" />
                                        <TextBlock x:Name="SysOrgSub" Style="{StaticResource ValueSubText}" />
                                    </StackPanel>
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.sys.extra}"
                                                   Description="{local:Loc settings.sys.extraDesc}">
                                    <TextBlock x:Name="SysExtra" Style="{StaticResource ValueText}" />
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.sys.since}"
                                                   Description="{local:Loc settings.sys.sinceDesc}">
                                    <StackPanel>
                                        <TextBlock x:Name="SysSince" Style="{StaticResource ValueText}" />
                                        <TextBlock x:Name="SysSinceSub" Style="{StaticResource ValueSubText}" />
                                    </StackPanel>
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.sys.session}"
                                                   Description="{local:Loc settings.sys.sessionDesc}">
                                    <StackPanel>
                                        <TextBlock x:Name="SysToken" Style="{StaticResource ValueText}" />
                                        <TextBlock x:Name="SysTokenSub" Style="{StaticResource ValueSubText}" />
                                    </StackPanel>
                                </local:SettingsRow>
                            </StackPanel>
                        </Border>

                        <!-- ===== The Claude Code installation ===== -->
                        <TextBlock Text="{local:Loc settings.sys.install}" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <local:SettingsRow Header="{local:Loc settings.sys.cli}"
                                                   Description="{local:Loc settings.sys.cliDesc}">
                                    <StackPanel>
                                        <TextBlock x:Name="SysCli" Style="{StaticResource ValueText}" />
                                        <TextBlock x:Name="SysCliSub" Style="{StaticResource ValueSubText}" />
                                    </StackPanel>
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.sys.configDir}"
                                                   Description="{local:Loc settings.sys.configDirDesc}">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="SysConfigDir" Style="{StaticResource ValueText}" />
                                            <TextBlock x:Name="SysConfigDirSub" Style="{StaticResource ValueSubText}" />
                                        </StackPanel>
                                        <Button x:Name="SysOpenConfig" MinWidth="86" Padding="12,5"
                                                Margin="14,0,0,0" VerticalAlignment="Center"
                                                Click="SysOpenFolder_Click"
                                                Content="{local:Loc settings.sys.open}" />
                                    </StackPanel>
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.sys.projects}"
                                                   Description="{local:Loc settings.sys.projectsDesc}">
                                    <TextBlock x:Name="SysProjects" Style="{StaticResource ValueText}" />
                                </local:SettingsRow>
                            </StackPanel>
                        </Border>

                        <!-- ===== This app + the machine ===== -->
                        <TextBlock Text="{local:Loc settings.sys.app}" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <local:SettingsRow Header="{local:Loc settings.sys.tray}"
                                                   Description="{local:Loc settings.sys.trayDesc}">
                                    <StackPanel>
                                        <TextBlock x:Name="SysApp" Style="{StaticResource ValueText}" />
                                        <TextBlock x:Name="SysAppSub" Style="{StaticResource ValueSubText}" />
                                    </StackPanel>
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.sys.machine}"
                                                   Description="{local:Loc settings.sys.machineDesc}">
                                    <StackPanel>
                                        <TextBlock x:Name="SysOs" Style="{StaticResource ValueText}" />
                                        <TextBlock x:Name="SysOsSub" Style="{StaticResource ValueSubText}" />
                                    </StackPanel>
                                </local:SettingsRow>

                                <Border Style="{StaticResource RowDivider}" />

                                <local:SettingsRow Header="{local:Loc settings.sys.dataDir}"
                                                   Description="{local:Loc settings.sys.dataDirDesc}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="SysDataDir" Style="{StaticResource ValueText}"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="SysOpenData" MinWidth="86" Padding="12,5"
                                                Margin="14,0,0,0" VerticalAlignment="Center"
                                                Click="SysOpenFolder_Click"
                                                Content="{local:Loc settings.sys.open}" />
                                    </StackPanel>
                                </local:SettingsRow>
                            </StackPanel>
                        </Border>

                        <!-- Copy for a bug report. It copies exactly what is on screen, so a masked
                             holder stays masked in the clipboard too. -->
                        <StackPanel Orientation="Horizontal" Margin="2,14,0,4">
                            <Button x:Name="SysCopyButton" MinWidth="150" Padding="14,6"
                                    Click="SysCopy_Click" Content="{local:Loc settings.sys.copy}" />
                            <TextBlock x:Name="SysCopyHint" VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontSize="12" TextWrapping="Wrap" MaxWidth="380"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{local:Loc settings.sys.copyHint}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ========================= ABOUT PAGE ========================= -->
            <Grid x:Name="AboutPane" Grid.Row="0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- HERO: full-bleed Claude clay/coral gradient with the logo, name, tagline,
                             and version/platform chips. This is the "bold" surface. -->
                        <Border MinHeight="188">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E89072" Offset="0" />
                                    <GradientStop Color="#D97757" Offset="0.55" />
                                    <GradientStop Color="#B0512F" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="32,26,32,26">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Logo on a soft white plate so the clay tile reads on the gradient. -->
                                    <Border Width="104" Height="104" CornerRadius="22"
                                            Background="#22FFFFFF" Padding="6">
                                        <Image x:Name="LogoImage" Width="92" Height="92"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Margin="22,0,0,0" VerticalAlignment="Center" MaxWidth="360">
                                        <TextBlock Text="Claude Code Tray"
                                                   FontSize="29" FontWeight="Bold"
                                                   Foreground="White" TextWrapping="Wrap" />
                                        <TextBlock Text="{local:Loc settings.about.tagline}"
                                                   Margin="0,4,0,0" FontSize="13"
                                                   TextWrapping="Wrap" Foreground="#EEFFFFFF" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Border Style="{StaticResource HeroChip}">
                                                <TextBlock x:Name="HeroVersion" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Style="{StaticResource HeroChip}">
                                                <TextBlock Text="{local:Loc settings.about.platform}" Foreground="White" FontSize="12" />
                                            </Border>
                                            <Border Style="{StaticResource HeroChip}">
                                                <TextBlock Text=".NET 10" Foreground="White" FontSize="12" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- BODY -->
                        <StackPanel Margin="32,22,32,26">
                            <TextBlock TextWrapping="Wrap" LineHeight="20"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{local:Loc settings.about.intro}" />

                            <!-- Quick links — clickable cards (URL in each card's Tag). -->
                            <TextBlock Text="{local:Loc settings.about.links}"
                                       FontSize="16" FontWeight="SemiBold" Margin="0,22,0,12"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <UniformGrid Columns="2" Margin="-6,0,-6,0">
                                <Border Style="{StaticResource LinkCard}" Margin="6"
                                        MouseLeftButtonUp="Link_Click"
                                        Tag="https://github.com/alegauss/claude-tray">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🐙" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{local:Loc settings.about.github}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{local:Loc settings.about.githubDesc}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource LinkCard}" Margin="6"
                                        MouseLeftButtonUp="Link_Click"
                                        Tag="https://github.com/alegauss/claude-tray/releases">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📦" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{local:Loc settings.about.releases}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{local:Loc settings.about.releasesDesc}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource LinkCard}" Margin="6"
                                        MouseLeftButtonUp="Link_Click"
                                        Tag="https://github.com/alegauss/claude-tray/issues/new">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🐛" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{local:Loc settings.about.report}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{local:Loc settings.about.reportDesc}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource LinkCard}" Margin="6"
                                        MouseLeftButtonUp="Link_Click"
                                        Tag="https://github.com/alegauss/claude-tray">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{local:Loc settings.about.star}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{local:Loc settings.about.starDesc}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Get involved -->
                            <TextBlock Text="{local:Loc settings.about.involved}"
                                       FontSize="16" FontWeight="SemiBold" Margin="0,22,0,12"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                            <Border CornerRadius="10" Padding="18,16"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{local:Loc settings.about.involvedIntro}" />
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Margin="0,0,0,6" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="{local:Loc settings.about.involved1}" />
                                        <TextBlock Margin="0,0,0,6" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="{local:Loc settings.about.involved2}" />
                                        <TextBlock Margin="0,0,0,6" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="{local:Loc settings.about.involved3}" />
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="{local:Loc settings.about.involved4}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Unofficial / community disclaimer (mirrors the README). -->
                            <TextBlock Margin="2,18,2,0" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="{local:Loc settings.about.disclaimer}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== Footer (shared) ===== -->
            <Grid Grid.Row="1" Margin="32,12,32,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="VersionText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Saving no longer closes anything (the page lives inside the shell), so it says
                         so here for a few seconds instead. -->
                    <TextBlock x:Name="SavedText" Visibility="Collapsed" VerticalAlignment="Center"
                               Margin="0,0,14,0" FontWeight="SemiBold"
                               Text="{local:Loc settings.saved}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="CancelButton" Content="{local:Loc settings.cancel}"
                            MinWidth="92" Padding="14,6" Margin="0,0,8,0"
                            Click="Cancel_Click" />
                    <Button x:Name="SaveButton" Content="{local:Loc settings.save}"
                            MinWidth="92" Padding="14,6"
                            Style="{DynamicResource AccentButtonStyle}"
                            Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
